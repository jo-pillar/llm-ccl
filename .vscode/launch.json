{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SyCCL Two-Agent: CLI 1 Round",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/agent/.venv/bin/python",
      "program": "${workspaceFolder}/agent/scripts/run_syccl_two_agent.py",
      "cwd": "${workspaceFolder}/agent",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/agent"
      },
      "args": [
        "--topo",
        "${workspaceFolder}/agent/examples/topologies/clos_2host.py",
        "--output-dir",
        "${workspaceFolder}/result/debug-syccl-two-agent",
        "--rounds",
        "1",
        "--message-size",
        "4096",
        "--flow-sim-bin",
        "${workspaceFolder}/Flow-Simulator/flow-sim-rs/target/debug/flow-sim-rs",
        "--env-toml",
        "${workspaceFolder}/agent/env.toml",
        "--save-llm-io"
      ]
    },
    {
      "name": "SyCCL Two-Agent: CLI 5 Rounds",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/agent/.venv/bin/python",
      "program": "${workspaceFolder}/agent/scripts/run_syccl_two_agent.py",
      "cwd": "${workspaceFolder}/agent",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/agent"
      },
      "args": [
        "--topo",
        "${workspaceFolder}/agent/examples/topologies/clos_2host.py",
        "--output-dir",
        "${workspaceFolder}/result/debug-syccl-two-agent",
        "--rounds",
        "5",
        "--message-size",
        "4096",
        "--flow-sim-bin",
        "${workspaceFolder}/Flow-Simulator/flow-sim-rs/target/debug/flow-sim-rs",
        "--env-toml",
        "${workspaceFolder}/agent/env.toml",
        "--save-llm-io"
      ]
    },
    {
      "name": "SyCCL Two-Agent: Unit Test Flow",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/agent/.venv/bin/python",
      "module": "pytest",
      "cwd": "${workspaceFolder}/agent",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/agent"
      },
      "args": [
        "-q",
        "tests/test_syccl_two_agent.py"
      ]
    }
  ]
}
